   ]
  },
  {
   "id": "season",
   "name": "季节与批次",
   "description": "可出行月份、最佳季节、气温区间与成团规则",
   "tags": [
    "season",
    "weather",
    "schedule"
   ],
   "examples": [
    "几月去最好？",
