{
 "protocolVersion": "0.3.0",
 "name": "小贝",
 "description": "我叫小贝，是「贝加尔湖50径」这条线的 AI 替身——贝加尔湖西岸利斯特维扬卡到大戈洛那段约 50 公里的重装徒步路线。我不是人。 这条线的中文推广人、领队是怪咖叔。他本人从头到尾走过这条线，俄语可以直接带队、沟通和翻译。",
 "url": "https://ai.baikal50.cn/api/a2a",
 "preferredTransport": "JSONRPC",
 "version": "1.0.0",
 "provider": {
  "organization": "贝加尔湖50径",
  "url": "https://baikal50.cn/"
 },
